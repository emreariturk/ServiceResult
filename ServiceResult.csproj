<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageOutputPath>./nupkg</PackageOutputPath>

    <PackageId>ServiceResult</PackageId>
    <Description>Lightweight, zero-dependency Result&lt;T&gt; wrapper for .NET, WCF, Web API, and ASP.NET Core Minimal APIs with automatic RFC 9457 ProblemDetails HTTP status mapping. | .NET, WCF, Web API ve ASP.NET Core Minimal API projeleri için sıfır bağımlılıklı Result&lt;T&gt; yanıt sarmalayıcısı ve otomatik RFC 9457 ProblemDetails HTTP durum kodu eşleyicisi.</Description>
    <PackageTags>api-response;result-pattern;minimal-api;wcf;problem-details;rfc9457;aspnet-core;endpoint-filter;error-handling;netstandard</PackageTags>
    <PackageReleaseNotes>Initial release: Multi-targeted Result, Result&lt;T&gt;, Error types for .NET Standard 2.0 (WCF/Legacy) and .NET 8+ Minimal APIs with automatic ProblemDetails mapping.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>